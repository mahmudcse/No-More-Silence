includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest/phpstan-pest-extension.neon

parameters:
    level: 6
    paths:
        - app/
        - database/
        - tests/

    tmpDir: build/phpstan

    excludePaths:
        analyse:
            - app/Filament/Resources/Roles
